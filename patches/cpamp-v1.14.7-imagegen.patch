+func (s *Service) correctLegacyImageHeaderEntry(ctx context.Context, accountKey string, entry WriteEntry) (WriteEntry, error) {
+	// The browser uses the canonical event hash; internal ingestion uses the
+	// provider request ID. Avoid a history lookup on the collector hot path.
+	if entry.Observation == nil || !usage.IsCanonicalSHA256Hex(entry.Observation.SourceObservationID) {
+		return entry, nil
+	}
+	needsCheck := false
+	for _, window := range entry.Windows {
+		if window.Source == "response_header" && (window.ModelScopeKind == "all" || codexquota.IsMainScope(window.ModelScopeKind, window.ModelScopeKey)) {
+			needsCheck = true
+		}
+	}
+	if !needsCheck {
+		return entry, nil
+	}
+	candidates, err := s.store.QuotaSnapshots.ListCandidates(ctx, accountKey, "codex", 0)
+	if err != nil {
+		return entry, err
+	}
+	entry.Windows = append([]WindowInput(nil), entry.Windows...)
+	for index, window := range entry.Windows {
+		if window.Source != "response_header" || (window.ModelScopeKind != "all" && !codexquota.IsMainScope(window.ModelScopeKind, window.ModelScopeKey)) {
+			continue
+		}
+		var match *model.AccountQuotaSnapshot
+		for candidateIndex := range candidates {
+			candidate := &candidates[candidateIndex]
+			if candidate.Source != "response_header" || candidate.SourceObservationID != entry.Observation.SourceObservationID || candidate.ModelScopeKind != "feature" || !isImagegenScopeKey(candidate.ModelScopeKey) || candidate.ObservedAtMS != window.ObservedAtMS || window.ObservedAtMS <= 0 || window.DurationSeconds == nil || candidate.DurationSeconds == nil || *window.DurationSeconds != *candidate.DurationSeconds {
+				continue
+			}
+			// Matching the balance as well as exact observation time and duration
+			// avoids reclassifying unrelated coding quota with a daily duration.
+			if window.UsedPercent == nil || candidate.UsedPercent == nil || *window.UsedPercent != *candidate.UsedPercent {
+				continue
+			}
+			if match != nil && (match.ModelScopeKey != candidate.ModelScopeKey || match.ProviderWindowID != candidate.ProviderWindowID) {
+				return entry, errors.New("ambiguous legacy image header evidence")
+			}
+			match = candidate
+		}
+		if match != nil {
+			entry.Windows[index].ProviderWindowID = match.ProviderWindowID
+			entry.Windows[index].ProviderWindowAliases = nil
+			entry.Windows[index].ModelScopeKind = "feature"
+			entry.Windows[index].ModelScopeKey = match.ModelScopeKey
+			entry.Windows[index].ModelIDs = nil
+		}
+	}
+	return entry, nil
+}
