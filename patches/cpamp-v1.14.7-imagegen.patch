+
+func imagegenHeaderScopeKey(activeLimit string, models ...string) string {
+	key := codexquota.NormalizeFeatureKey(activeLimit)
+	if isImagegenScopeKey(key) {
+		return key
+	}
+	// An explicit non-image limit is stronger evidence than the request model.
+	if strings.TrimSpace(activeLimit) != "" {
+		return ""
+	}
+	for _, model := range models {
+		model = codexquota.NormalizeModelID(model)
+		if model == "" {
+			continue
+		}
+		if strings.HasPrefix(model, "gpt-image-") || strings.HasPrefix(model, "dall-e-") {
+			return "imagegen"
+		}
+		break // resolved model wins over aliases, matching ResolveUsageScope
+	}
+	return ""
+}
