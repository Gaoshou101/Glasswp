+func TestImagegenHeaderQuotaIsolation(t *testing.T) {
+	const observedAtMS = int64(1_780_000_000_000)
+	for _, tc := range []struct{ name, activeLimit, model, resolved, key string }{
+		{"premium", "imagegen_premium", "gpt-image-2.5-sunburst", "", "imagegen_premium"},
+		{"alias", " IMAGEGEN_PREMIUM ", "my-image", "gpt-image-2.5-sunburst", "imagegen_premium"},
+		{"limit-over-model", "imagegen_premium", "gpt-5.6-sol", "", "imagegen_premium"},
+		{"missing-limit", "", "my-image", "gpt-image-2.5-sunburst", "imagegen"},
+		{"resolved-wins", "", "gpt-image-2.5-sunburst", "gpt-5.6-sol", ""},
+		{"coding-daily", "premium", "gpt-5.6-sol", "", ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			service, path := newQuotaSnapshotTestServiceWithPath(t, observedAtMS+10_000)
+			used, minutes := 0.0, 1440.0
+			event := usage.Event{
+				EventHash:   strings.Repeat("a", 64),
+				TimestampMS: observedAtMS, Provider: "codex", Model: tc.model, ResolvedModel: tc.resolved,
+				AuthFileSnapshot: "codex.json", AuthProviderSnapshot: "codex", AuthIndex: "auth-1",
+				AccountSnapshot: "user@example.com", RequestID: "req-imagegen",
+				ResponseMetadata: &usage.ResponseHeaderMetadata{Quota: &usage.HeaderQuotaMetadata{
+					ActiveLimit: tc.activeLimit, Primary: &usage.HeaderQuotaWindow{
+						UsedPercent: &used, WindowMinutes: &minutes, ResetAtMS: observedAtMS + 86_400_000,
+					},
+				}},
+			}
+			if err := service.WriteUsageEvents(context.Background(), []usage.Event{event}); err != nil {
+				t.Fatal(err)
+			}
+			id, inventory := "window-1d-0", "codex:rate-limits"
+			if tc.key != "" {
+				id = strings.ReplaceAll(tc.key, "_", "-") + "-0-window-1d-0"
+				inventory = "codex:feature:" + tc.key
+			}
+			window, ok := queryQuotaLifecycleWindows(t, service, false)[id]
+			if !ok {
+				t.Fatalf("missing isolated window %s", id)
+			}
+			if window.UsedPercent == nil || *window.UsedPercent != 0 || window.DurationSeconds == nil || *window.DurationSeconds != 86400 {
+				t.Fatalf("lost zero or duration: %#v", window)
+			}
+			if tc.key != "" && (window.ModelScopeKind != "feature" || window.ModelScopeKey != tc.key) {
+				t.Fatalf("wrong image scope: %#v", window)
+			}
+			if tc.key == "" && window.ModelScopeKey != "codex_main" {
+				t.Fatalf("changed coding scope: %#v", window)
+			}
+			db, err := sql.Open("sqlite", path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer db.Close()
+			var actual string
+			if err := db.QueryRow(`select inventory_scope_key from account_quota_observations limit 1`).Scan(&actual); err != nil {
+				t.Fatal(err)
+			}
+			if actual != inventory {
+				t.Fatalf("inventory %q, want %q", actual, inventory)
+			}
+			if tc.key == "" {
+				return
+			}
+			// The web client writes the same feature under the legacy inventory key.
+			entry, _ := quotaSnapshotEntryFromUsageEvent(event)
+			entry.Observation.InventoryScopeKey = "codex:rate-limits"
+			if _, err := service.Write(context.Background(), WriteRequest{Entries: []WriteEntry{entry}}); err != nil {
+				t.Fatal(err)
+			}
+			// An already-open old web tab sends the same header under codex_main
+			// with an event hash instead of the backend request ID.
+			legacy := quotaLifecycleWriteEntryWithObservation("partial", "response_header", strings.Repeat("a", 64), "codex:rate-limits", observedAtMS, entry.Windows)
+			legacy.Windows[0].ModelScopeKind = "family"
+			legacy.Windows[0].ModelScopeKey = "codex_main"
+			legacy.Windows[0].ProviderWindowID = "window-1d-0"
+			legacy.Windows[0].WindowMode = "unknown"
+			legacy.Windows[0].BoundaryAccuracy = "unknown"
+			if _, err := service.Write(context.Background(), WriteRequest{Entries: []WriteEntry{legacy}}); err != nil {
+				t.Fatal(err)
+			}
+			// Repeated complete Codex inventories must not deactivate image quota.
+			for i := 1; i <= 2; i++ {
+				entry := quotaLifecycleWriteEntryWithObservation("complete", "api_query", fmt.Sprintf("main-%d", i), "codex:rate-limits", observedAtMS+int64(i)*1000, nil)
+				if _, err := service.Write(context.Background(), WriteRequest{Entries: []WriteEntry{entry}}); err != nil {
+					t.Fatal(err)
+				}
+			}
+			windows := queryQuotaLifecycleWindows(t, service, false)
+			if len(windows) != 1 || windows[id].Availability != "active" {
+				t.Fatalf("image quota duplicated or deactivated: %#v", windows)
+			}
+			if windows[id].CycleEndMS == nil || *windows[id].CycleEndMS != observedAtMS+86_400_000 {
+				t.Fatalf("legacy web replay erased image reset boundary: %#v", windows[id])
+			}
+		})
+	}
+}
